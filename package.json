{
  "name": "coddy",
  "displayName": "Coddy",
  "description": "Code-agent console for opencode inside VS Code",
  "version": "0.2.1",
  "icon": "media/icon.png",
  "publisher": "hafidmermouri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hafidmermouri/coddy.git"
  },
  "bugs": {
    "url": "https://github.com/hafidmermouri/coddy/issues"
  },
  "homepage": "https://github.com/hafidmermouri/coddy#readme",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "coddy",
          "title": "Coddy",
          "icon": "media/icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "coddy-usage",
          "title": "Coddy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "coddy": [
        {
          "type": "webview",
          "id": "coddy.chat",
          "name": "Agent"
        }
      ],
      "coddy-usage": [
        {
          "type": "webview",
          "id": "coddy.usage",
          "name": "Usage"
        }
      ]
    },
    "commands": [
      {
        "command": "coddy.open",
        "title": "Open Coddy",
        "category": "Coddy",
        "icon": {
          "light": "media/icon-light.svg",
          "dark": "media/icon.svg"
        }
      },
      {
        "command": "coddy.newTab",
        "title": "New session in tab",
        "category": "Coddy"
      },
      {
        "command": "coddy.askAboutSelection",
        "title": "Ask about selection",
        "category": "Coddy"
      },
      {
        "command": "coddy.attachDiagnostics",
        "title": "Attach diagnostics for current file",
        "category": "Coddy"
      },
      {
        "command": "coddy.newSession",
        "title": "New session",
        "category": "Coddy"
      },
      {
        "command": "coddy.restartServer",
        "title": "Restart server",
        "category": "Coddy"
      }
    ],
    "keybindings": [
      {
        "command": "coddy.askAboutSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "coddy.askAboutSelection",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "coddy.open",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Coddy",
      "properties": {
        "coddy.binaryPath": {
          "type": "string",
          "default": "opencode",
          "description": "Path to the opencode binary. Used to spawn `opencode serve`."
        },
        "coddy.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Use an already running opencode server instead of spawning one, e.g. http://opencode:PASSWORD@127.0.0.1:4096"
        }
      }
    }
  },
  "scripts": {
    "build": "vite build --config vite.config.extension.mts && vite build --config vite.config.mts",
    "watch": "vite build --config vite.config.extension.mts --watch",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "gen:api": "node scripts/gen-api.mjs",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "openapi-fetch": "^0.17.0",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.1.1"
  }
}
